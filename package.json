{
  "name": "inkpaper",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first assignment-to-handwriting studio",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:export": "node scripts/verify-export.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "mammoth": "^1.13.0",
    "next": "^15.5.27",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "docx": "^9.9.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
